[Unit]
Description=Block Stack multiplayer server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=block-stack
Group=block-stack
WorkingDirectory=/opt/block-stack/current
Environment=BS_BIND=127.0.0.1:3010
StateDirectory=block-stack
StateDirectoryMode=0700
Environment=BS_DATA_DIR=/var/lib/block-stack
Environment=BS_DIST=/opt/block-stack/current/dist
EnvironmentFile=-/etc/block-stack/env
ExecStart=/opt/block-stack/current/bin/bs-server
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
